 /* wallust template - colors-rofi */

* {
active-background: #844F59;
active-foreground: #DDC4C8;
normal-background: #000004;
normal-foreground: #DDC4C8;
urgent-background: #7E5E62;
urgent-foreground: #DDC4C8;

alternate-active-background: #2F3440;
alternate-active-foreground: #DDC4C8;
alternate-normal-background: #000004;
alternate-normal-foreground: #DDC4C8;
alternate-urgent-background: #000004;
alternate-urgent-foreground: #DDC4C8;

selected-active-background: #7E5E62;
selected-active-foreground: #DDC4C8;
selected-normal-background: #7E5E62;
selected-normal-foreground: #DDC4C8;
selected-urgent-background: #7E5E62;
selected-urgent-foreground: #DDC4C8;

background-color: #000004;
background: rgba(0,0,0,0.7);
foreground: #DDC4C8;
border-color: #844F59;

color0: #000004;
color1: #212730;
color2: #222730;
color3: #232730;
color4: #633B42;
color5: #5E4749;
color6: #774249;
color7: #C6A3A7;
color8: #8B7275;
color9: #2C3440;
color10: #2E3440;
color11: #2F3440;
color12: #844F59;
color13: #7E5E62;
color14: #9F5761;
color15: #C6A3A7;


}

